{
  "schema_id": "p3-podcast-processor-v1",
  "name": "P3 Podcast Processor LUI",
  "description": "Language User Interface for automated podcast processing, transcription, and content generation",
  "version": "1.0.0",
  "domain": {
    "domain_name": "podcast-processing",
    "subdomain": "content-automation",
    "description": "Automated podcast ingestion, transcription, summarization, and blog generation",
    "key_concepts": [
      "podcasts",
      "episodes",
      "transcripts",
      "summaries",
      "digests",
      "blog posts",
      "RSS feeds",
      "AI processing"
    ],
    "terminology": {
      "digest": "A structured summary of podcast episodes",
      "transcription": "Converting audio to text",
      "Parakeet": "MLX-optimized transcription engine for Apple Silicon",
      "P3": "Parakeet Podcast Processor"
    }
  },
  "components": [
    {
      "component_id": "fetch-episodes",
      "component_type": "ACTION",
      "intent": "Download new podcast episodes",
      "invocation": {
        "primary_phrase": "fetch new episodes",
        "alternate_phrases": [
          "download episodes",
          "get new podcasts",
          "update podcasts",
          "sync podcasts"
        ],
        "examples": [
          "Fetch new episodes",
          "Download the latest 5 episodes",
          "Get new episodes from All-In",
          "Update all my podcasts"
        ],
        "context_requirements": null
      },
      "parameters": [
        {
          "name": "max_episodes",
          "param_type": "NUMBER",
          "description": "Maximum number of episodes to download per feed",
          "required": false,
          "default_value": "10",
          "extraction_hints": ["latest", "last", "most recent", "episodes"],
          "validation": null
        },
        {
          "name": "podcast_name",
          "param_type": "STRING",
          "description": "Specific podcast to fetch from",
          "required": false,
          "default_value": null,
          "extraction_hints": ["from", "podcast", "show"],
          "validation": null
        }
      ],
      "feedback": {
        "success_template": "Downloaded {count} new episodes from {feeds} feeds",
        "error_template": "Could not fetch episodes: {error}",
        "progress_template": "Fetching episodes from {current_feed}...",
        "confirmation_required": false,
        "confirmation_prompt": null
      },
      "accessibility": null
    },
    {
      "component_id": "transcribe-episodes",
      "component_type": "ACTION",
      "intent": "Transcribe audio to text",
      "invocation": {
        "primary_phrase": "transcribe episodes",
        "alternate_phrases": [
          "convert audio to text",
          "generate transcripts",
          "process audio"
        ],
        "examples": [
          "Transcribe all pending episodes",
          "Transcribe episode 42",
          "Convert the latest episode to text"
        ],
        "context_requirements": null
      },
      "parameters": [
        {
          "name": "episode_id",
          "param_type": "NUMBER",
          "description": "Specific episode ID to transcribe",
          "required": false,
          "default_value": null,
          "extraction_hints": ["episode", "id", "number"],
          "validation": null
        },
        {
          "name": "model",
          "param_type": "STRING",
          "description": "Whisper model size (tiny, base, small, medium, large)",
          "required": false,
          "default_value": "base",
          "extraction_hints": ["model", "using"],
          "validation": null
        }
      ],
      "feedback": {
        "success_template": "Transcribed {count} episodes successfully",
        "error_template": "Transcription failed: {error}",
        "progress_template": "Transcribing: {episode_title} ({progress}%)",
        "confirmation_required": false,
        "confirmation_prompt": null
      },
      "accessibility": null
    },
    {
      "component_id": "generate-summaries",
      "component_type": "ACTION",
      "intent": "Generate AI summaries from transcripts",
      "invocation": {
        "primary_phrase": "generate summaries",
        "alternate_phrases": [
          "summarize episodes",
          "create digests",
          "process transcripts",
          "analyze episodes"
        ],
        "examples": [
          "Generate summaries for all transcribed episodes",
          "Summarize episode 42",
          "Create a digest of today's episodes"
        ],
        "context_requirements": null
      },
      "parameters": [
        {
          "name": "episode_id",
          "param_type": "NUMBER",
          "description": "Specific episode ID to summarize",
          "required": false,
          "default_value": null,
          "extraction_hints": ["episode", "id"],
          "validation": null
        },
        {
          "name": "provider",
          "param_type": "STRING",
          "description": "LLM provider (ollama, openai, anthropic)",
          "required": false,
          "default_value": "ollama",
          "extraction_hints": ["using", "with", "provider"],
          "validation": null
        }
      ],
      "feedback": {
        "success_template": "Generated summaries for {count} episodes",
        "error_template": "Summary generation failed: {error}",
        "progress_template": "Summarizing: {episode_title}",
        "confirmation_required": false,
        "confirmation_prompt": null
      },
      "accessibility": null
    },
    {
      "component_id": "export-digest",
      "component_type": "ACTION",
      "intent": "Export daily digest to file",
      "invocation": {
        "primary_phrase": "export digest",
